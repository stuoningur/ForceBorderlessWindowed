<?xml version="1.0" encoding="utf-8"?>
<!--
  The release: one portable exe, bin\Publish\ForceBorderlessWindowed.exe.
  Visual Studio: right-click the project → Publish → Portable → Publish.
  Command line:  dotnet publish ForceBorderlessWindowed -p:PublishProfile=Portable

  Framework-dependent: needs the .NET 10 Desktop Runtime (if it's missing, the exe shows a dialog with a download link).
  Not self-contained on purpose: as a single file that would unpack WPF's native DLLs into %TEMP% and load them from
  there, also in the admin autostart copy, and any program of the user can write to %TEMP%.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>bin\Publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
