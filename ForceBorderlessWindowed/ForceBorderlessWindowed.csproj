<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Shown as is in About and the log. The number part (0.9.0) is what the version handover compares
         (see SingleInstance), so every release needs a higher number, not just a different suffix. -->
    <Version>0.9.0-beta</Version>
    <Product>Force Borderless Windowed</Product>
    <!-- The exe's "File description": the name Task Manager shows, also on its Startup apps page -->
    <AssemblyTitle>Force Borderless Windowed</AssemblyTitle>
    <Description>Forces games into borderless windowed mode</Description>
    <Authors>Stuoningur</Authors>
    <Copyright>© 2026 Stuoningur</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Release builds. How the portable exe is packed is in Properties\PublishProfiles\Portable.pubxml. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Debug symbols inside the exe: stack traces in logs keep their line numbers, and there's no .pdb to ship -->
    <DebugType>embedded</DebugType>
    <!-- The admin autostart copy runs elevated, but with the user's environment variables, which any of the user's
         programs can set. Two of them would make it load code from a folder those programs can write to:
         DOTNET_ROOT (where to find .NET) and DOTNET_STARTUP_HOOKS. Global: the exe only uses .NET installed for all
         users (Program Files, or the location registered in HKLM). Takes effect when publishing. -->
    <AppHostDotNetSearch>Global</AppHostDotNetSearch>
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests check internal classes (the watcher's rules, the settings repair) directly -->
    <InternalsVisibleTo Include="ForceBorderlessWindowed.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Own entry point in Program.cs instead of the generated Main -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Strings class is generated by MSBuild on every build (into obj\), not by the VS custom tool.
         So CLI and VS builds always match the .resx. Don't set an Access Modifier in the resx editor. -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>ForceBorderlessWindowed.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- WPF compiles a temporary assembly (*_wpftmp) to resolve XAML references like {x:Static res:Strings...}.
       That build only runs CoreCompile, not resource generation, so the Strings class would be missing there.
       This makes sure the resource class is generated before every compile. In the normal build these
       targets have already run and are skipped. -->
  <Target Name="GenerateStronglyTypedResourcesBeforeCompile"
          BeforeTargets="CoreCompile"
          DependsOnTargets="PrepareResourceNames;CoreResGen" />

  <ItemGroup>
    <!-- Tray artwork, one file per taskbar color (see TrayIconRenderer). AppIcon.ico isn't listed here: it's only
         the exe's icon (ApplicationIcon above), and windows without an Icon of their own take theirs from the exe. -->
    <Resource Include="Resources\TrayIcon.DarkTaskbar.ico" />
    <Resource Include="Resources\TrayIcon.LightTaskbar.ico" />
    <!-- License texts of the libraries bundled into the exe, shown under General → About (see AppInfo) -->
    <EmbeddedResource Include="Resources\ThirdPartyNotices.txt" LogicalName="ThirdPartyNotices.txt" />
  </ItemGroup>

</Project>
