<Window x:Class="ForceBorderlessWindowed.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ForceBorderlessWindowed.Resources"
        Title="{x:Static res:Strings.AppName}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!-- Layout of a WinUI ContentDialog: title + text on the window background, buttons in a footer
         of equal width, the primary (default) one in the accent color. Unlike the Win32 MessageBox/TaskDialog
         this follows the app's light/dark theme.
         Rows in reading order (text, then buttons): screen readers and tab order follow the element order. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,24">
            <TextBlock x:Name="TitleText" Style="{DynamicResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" />
            <!-- Technical details (e.g. the exception message): selectable, so it can be copied into a bug report -->
            <TextBox x:Name="DetailsText" Margin="0,12,0,0" Visibility="Collapsed"
                     IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.LabeledBy="{Binding ElementName=MessageText}"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="24"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <!-- Columns are created in code for the buttons that are used -->
            <Grid x:Name="ButtonGrid" />
        </Border>
    </Grid>
</Window>
