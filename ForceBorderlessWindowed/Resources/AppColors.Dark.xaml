<!-- App colors for the dark theme: Fluent's values, which already have enough contrast in dark mode. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#19000000" />
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="AppCardBackgroundPointerOverBrush" Color="#15FFFFFF" />
</ResourceDictionary>
